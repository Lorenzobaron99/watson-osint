#!/usr/bin/env python3
"""Watson Terminal Chat — talk to Watson from the command line."""

import sys
import json
import urllib.request
import os

WATSON_URL = os.environ.get("WATSON_URL", "http://localhost:8777")

def chat(message):
    """Send a message to Watson and get the response."""
    body = json.dumps({"message": message, "findings": [], "history": []}).encode()
    req = urllib.request.Request(
        f"{WATSON_URL}/api/chat",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    try:
        resp = urllib.request.urlopen(req, timeout=120)
        data = json.loads(resp.read())
        return data.get("response", "(no response)")
    except Exception as e:
        return f"Error: {e}"

def stream_investigate(query):
    """Run a streaming investigation and print events as they arrive."""
    import select
    body = json.dumps({"query": query}).encode()
    req = urllib.request.Request(
        f"{WATSON_URL}/api/investigate/stream",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    try:
        resp = urllib.request.urlopen(req, timeout=120)
        fp = resp.fp
        ce = ""
        while True:
            ready = select.select([fp], [], [], 30.0)
            if not ready[0]:
                break
            line = fp.readline().decode()
            if not line:
                break
            if line.startswith("event:"):
                ce = line.strip().replace("event: ", "")
            elif line.startswith("data:"):
                try:
                    d = json.loads(line.strip().replace("data: ", ""))
                    if ce == "reasoning":
                        print(f"\n🧠 {d.get('investigation_goal', '')}")
                    elif ce == "tool_start":
                        print(f"  🔧 {d.get('tool', '?')}")
                    elif ce == "tool_complete":
                        fc = d.get("finding_count", 0)
                        print(f"  ✅ {d.get('tool', '?')} ({fc} findings)")
                    elif ce == "cross_reference":
                        print(f"  🔗 {d.get('total', 0)} cross-references")
                    elif ce == "done":
                        r = d.get("result", d)
                        print(f"\n🏁 Done: {r.get('findings', 0)} findings")
                        summary = r.get("summary", "")
                        if summary:
                            print(summary[:800])
                        return
                    elif ce == "error":
                        print(f"  ❌ {d.get('message', '')}")
                        return
                except:
                    pass
    except Exception as e:
        print(f"Error: {e}")

def main():
    print("🕵️  Watson Terminal Chat")
    print("   Type 'exit' to quit, 'investigate <target>' for full sweep, or just ask a question.")
    print()

    while True:
        try:
            query = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n👋")
            break

        if not query:
            continue
        if query.lower() in ("exit", "quit", "q"):
            break
        if query.lower().startswith("investigate "):
            target = query[12:].strip()
            stream_investigate(target)
        else:
            print("  ...", end="\r")
            response = chat(query)
            print(f"\n{response}\n")

if __name__ == "__main__":
    main()
