# Watson OSINT — Environment Configuration
# Copy to .env and fill in your API keys

# ── Server ───────────────────────────────────────────────
WATSON_PORT=8777
WATSON_HOST=0.0.0.0
# Get your API key from the Watson config file (~/.watson/config)
WATSON_API_KEY=change-me-get-from-watson-config
LOG_LEVEL=INFO

# ── API Keys ─────────────────────────────────────────────
ETHERSCAN_API_KEY=
DEEPSEEK_API_KEY=
HERMES_API_KEY=

# ── Infrastructure ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=watson123
NATS_URL=nats://nats:4222

# ── Persistence ──────────────────────────────────────────
WATSON_DB_PATH=/data/investigations.db
WATSON_CASES_DIR=/data/cases
