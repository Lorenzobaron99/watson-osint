# Watson OSINT — API Keys
# Watson loads these from the environment. You can also set them in your shell profile.
#
# HOW TO GET KEYS:
#   OpenCorporates → https://opencorporates.com/api_accounts/new (free tier available)
#   OpenSanctions  → https://www.opensanctions.org/api/ (free tier available)
#   HIBP           → https://haveibeenpwned.com/API/Key (paid, $3.50/month)

# OpenCorporates — company registry searches
# Without this key: Watson shows "API key required" error (doesn't hallucinate)
OPENCORPORATES_API_KEY=

# OpenSanctions — sanctions/PEP database
# Without this key: Watson shows "API key required" error (doesn't hallucinate)
OPENSANCTIONS_API_KEY=

# HIBP (Have I Been Pwned) — breach checking
# Without this key: breach checks are skipped
HIBP_API_KEY=
